{
  "env": {
    "browser": true,
    "es2021": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-unused-vars": ["error", { "args": "none" }],
    "no-constant-condition": "error",
    "eqeqeq": ["error", "always"],
    "no-var": "warn"
  },
  "overrides": [
    {
      "files": ["js/utils.js", "js/api.js"],
      "env": {
        "browser": false,
        "node": true
      },
      "parserOptions": {
        "sourceType": "script"
      }
    }
  ]
}
